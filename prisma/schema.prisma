generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Category {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  name String
}

model Formation {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  status    String
  createdAt DateTime @default(now())
}